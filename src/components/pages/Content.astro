---
import Icon from '../Icon.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { getRoutes, contentPages } from '../../lib/catalog';
import { messages, infoPath, localePath } from '../../lib/i18n';
import { storeHours, storeLocations } from '../../lib/store-locations';
import type { Route } from '../../lib/types';
interface Props {
  route: Route;
}
const { route } = Astro.props,
  { lang, content } = route,
  t = messages(lang);
const known = new Set(getRoutes().map((r) => r.path));
function safeLinks(html: string) {
  return html.replace(
    /<a\b([^>]*?)href="([^"#]*)([^"]*)"([^>]*)>([\s\S]*?)<\/a>/gi,
    (whole, _before, href, _suffix, _after, text) => {
      if (href.startsWith('/') && !href.startsWith('//')) {
        const path = href.split('?')[0].replace(/\/?$/, '/');
        if (!known.has(path)) return text;
      }
      return whole;
    },
  );
}
const isContact = route.path === infoPath(lang, 'contact');
const isDelivery = route.path === infoPath(lang, 'delivery');
const storeSchema = storeLocations.map((store) => ({
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  '@id': new URL(`${infoPath('ru', 'contact')}#${store.id}`, Astro.site).href,
  name: `SIMAL — ${t[store.id]}`,
  url: new URL(`${route.path}#${store.id}`, Astro.site).href,
  telephone: store.telephone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: store.street[lang],
    addressLocality: t[store.id],
    addressCountry: 'GE',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    ...storeHours,
  },
  parentOrganization: { '@id': new URL('/#organization', Astro.site).href },
}));
const collection = route.kind === 'promotions' || route.kind === 'news';
const entries = collection
  ? contentPages.filter(
      (p) =>
        p.lang === lang &&
        p.kind === (route.kind === 'promotions' ? 'promotion' : 'news') &&
        p.path !== route.path,
    )
  : [];
const reviewMessage =
  lang === 'ru'
    ? 'Страница восстановлена из архива. Актуальные условия и сведения уточняйте у менеджера.'
    : lang === 'ka'
      ? 'გვერდი აღდგენილია არქივიდან. მიმდინარე ინფორმაცია დააზუსტეთ მენეჯერთან.'
      : 'This page was recovered from an archive. Please confirm current information with our team.';
---

{isContact && storeSchema.map((store) => (
  <script type="application/ld+json" set:html={JSON.stringify(store).replace(/</g, '\\u003c')} />
))}
<div class="container">
  <Breadcrumbs
    lang={lang}
    items={[{ title: content?.heading || route.title.replace(/ \| SIMAL$/, '') }]}
  />
  <div class="page-heading">
    <h1>{content?.heading || route.title.replace(/ \| SIMAL$/, '')}</h1>
  </div>
  {collection ? (
    <>
      <p class="notice">{t.archiveNotice}</p>
      <div class="content-list">
        {entries.map((p) => (
          <article>
            <p class="eyebrow muted">SIMAL · {t.promotions}</p>
            <h2>
              <a href={p.path}>{p.heading}</a>
            </h2>
            <p>{p.description}</p>
            <a class="text-link" href={p.path}>
              {t.details}
              <Icon name="arrow" size={16} />
            </a>
          </article>
        ))}
      </div>
      {!entries.length && (
        <div class="empty-state content-empty">
          <h2>{t.contactUs}</h2>
          <p>{t.deliveryText}</p>
          <a class="button" href={localePath(lang, 'catalog')}>
            {t.allCatalog}
          </a>
        </div>
      )}
    </>
  ) : (
    <>
      {content?.needsReview && (
        <p class="notice">{content.kind === 'promotion' ? t.archiveNotice : reviewMessage}</p>
      )}
      {isContact && (
        <div class="contact-cards">
          {storeLocations.map((store) => (
            <section class="contact-card" id={store.id}>
              <h2>{t[store.id]}</h2>
              <p>{store.street[lang]}</p>
              <p>{t.dailyHours} {storeHours.opens}–{storeHours.closes}</p>
              <a href={`tel:${store.telephone}`}>
                <Icon name="phone" size={20} />
                {store.displayPhone}
              </a>
            </section>
          ))}
          <section class="contact-card">
            <h2>Email</h2>
            <a href="mailto:info@simal.ge">
              <Icon name="mail" size={20} />
              info@simal.ge
            </a>
          </section>
          <section class="contact-card">
            <h2>WhatsApp</h2>
            <a href="https://wa.me/995571100515" target="_blank" rel="noopener noreferrer">
              {t.contactUs}
              <Icon name="arrow" size={20} />
            </a>
          </section>
        </div>
      )}
      {isDelivery ? (
        <div class="prose">
          <p>{t.deliveryPaymentHelp}</p>
          <p><a href={infoPath(lang, 'contact')}>{t.contactUs}</a></p>
          <p><a href={localePath(lang, 'catalog')}>{t.allCatalog}</a></p>
        </div>
      ) : !isContact && content?.html ? (
        <div class="prose" set:html={safeLinks(content.html)} />
      ) : (
        !isContact && (
          <div class="prose">
            <p>{t.deliveryText}</p>
            <p>
              <a href="tel:+995571100515">+995 571 10 05 15</a>
            </p>
            <p>
              <a href="mailto:info@simal.ge">info@simal.ge</a>
            </p>
          </div>
        )
      )}
    </>
  )}
</div>
