---
import Breadcrumbs from '../Breadcrumbs.astro';
import CatalogCategoryList from '../CatalogCategoryList.astro';
import Icon from '../Icon.astro';
import ProductCard from '../ProductCard.astro';
import {
  categories,
  productsForLanguage,
  categoryUrl,
  categoryTitle,
  categoryProducts,
} from '../../lib/catalog';
import { messages, localePath, formatProductCount } from '../../lib/i18n';
import type { Category, Route } from '../../lib/types';
interface Props {
  route: Route;
}
const { route } = Astro.props,
  { lang, category, kind } = route,
  t = messages(lang);
const languageProducts = productsForLanguage(lang);
const list = category ? categoryProducts(category, lang) : languageProducts;
const categoryIds = new Set(languageProducts.flatMap((product) => product.categoryIds));
const visibleCategories = new Map(categories.filter((item) => categoryIds.has(item.id)).map((item) => [item.id, item]));
const childrenByParent = new Map<string | undefined, Category[]>();
for (const item of visibleCategories.values()) {
  const parentId = item.parentId && visibleCategories.has(item.parentId) ? item.parentId : undefined;
  const children = childrenByParent.get(parentId) ?? [];
  children.push(item);
  childrenByParent.set(parentId, children);
}
const parent = category?.parentId ? visibleCategories.get(category.parentId) : undefined;
const activeBranch = new Set<string>();
for (let item = category; item && !activeBranch.has(item.id);) {
  activeBranch.add(item.id);
  item = item.parentId ? visibleCategories.get(item.parentId) : undefined;
}
const title = category
  ? categoryTitle(category, lang)
  : kind === 'search'
    ? t.searchTitle
    : t.catalog;
---

<div class="container" data-catalog-list>
  <Breadcrumbs
    lang={lang}
    items={[
      { title: t.catalog, url: category ? localePath(lang, 'catalog') : undefined },
      ...(parent ? [{ title: categoryTitle(parent, lang), url: categoryUrl(parent, lang) }] : []),
      ...(category ? [{ title }] : []),
    ]}
  />
  <div class="page-heading">
    <h1>{title}</h1>
    {!category && <p>{t.catalogIntro}</p>}
    {category?.id === 'myagkaya-mebel-divan-krovati' && <p>{t.sofaBedsGuide}</p>}
    {kind === 'search' && (
      <form class="search-form" action={localePath(lang, 'search')} role="search">
        <label class="sr-only" for="page-search">
          {t.search}
        </label>
        <input
          id="page-search"
          name="q"
          type="search"
          placeholder={t.searchPlaceholder}
          data-query
        />
        <button class="button" type="submit">
          <Icon name="search" size={20} />
          {t.search}
        </button>
      </form>
    )}
  </div>
  <div class="catalog-layout">
    <button type="button" class="filter-toggle" aria-expanded="false"
      aria-controls="catalog-filters" data-filter-toggle hidden>
      <Icon name="filter" size={16} />
      {t.catalogFilters}
    </button>
    <aside class="filter-panel" id="catalog-filters">
      <nav class="catalog-category-nav" aria-label={t.catalogSections}>
        <a href={localePath(lang, 'catalog')} aria-current={kind === 'catalog' ? 'page' : undefined}>{t.all}</a>
        <CatalogCategoryList lang={lang} categories={childrenByParent.get(undefined) ?? []}
          childrenByParent={childrenByParent} activeId={category?.id} activeBranch={activeBranch} />
      </nav>
      <h2>{t.filter}</h2>
      <div class="filter-price">
        <label>
          {t.minPrice}
          <input type="number" min="0" step="1" inputmode="numeric" data-price-min />
        </label>
        <label>
          {t.maxPrice}
          <input type="number" min="0" step="1" inputmode="numeric" data-price-max />
        </label>
      </div>
      <label class="check-label">
        <input type="checkbox" data-stock />
        {t.onlyStock}
      </label>
      <button class="button button--outline" data-reset-filters>
        {t.reset}
      </button>
    </aside>
    <div>
      <div class="catalog-toolbar">
        <p aria-live="polite" data-result-summary>{formatProductCount(list.length, lang)}</p>
        <label>
          <span class="sr-only">{t.sort}</span>
          <select data-sort>
            <option value="default">{t.recommended}</option>
            <option value="price-asc">{t.priceAsc}</option>
            <option value="price-desc">{t.priceDesc}</option>
            <option value="name">{t.nameAsc}</option>
          </select>
        </label>
      </div>
      <div class="product-grid" data-product-grid>
        {list.map((p) => (
          <ProductCard product={p} lang={lang} />
        ))}
      </div>
      <div class="empty-state" data-no-results hidden>
        <Icon name="search" size={35} />
        <h2>{t.noResults}</h2>
        <p>{t.noResultsHelp}</p>
        <button class="button button--outline" data-reset-filters>
          {t.reset}
        </button>
      </div>
      <button class="button button--outline load-more" data-load-more hidden>
        {lang === 'ru' ? 'Показать ещё' : lang === 'ka' ? 'მეტის ჩვენება' : 'Show more'}
      </button>
      <p class="archive-note">{t.archivedData}</p>
    </div>
  </div>
</div>
