---
import Base from '../layouts/Base.astro';
import { localePath } from '../lib/i18n';
const route = {
  path: '/404/',
  lang: 'ka' as const,
  kind: 'content' as const,
  title: 'გვერდი ვერ მოიძებნა | SIMAL',
  description: 'დაუბრუნდით SIMAL-ის ავეჯის კატალოგს.',
  noindex: true,
};
---

<Base route={route}>
  <div class="container not-found">
    <h1>404</h1>
    <p>გვერდი ვერ მოიძებნა. შესაძლოა, პროდუქტის მისამართი შეიცვალა.</p>
    <a class="button" href={localePath(route.lang, 'catalog')}>
      კატალოგის ნახვა
    </a>
  </div>
</Base>
