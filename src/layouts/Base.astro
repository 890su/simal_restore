---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import HeaderActions from '../components/HeaderActions.astro';
import { messages, basePath, localePath, infoPath } from '../lib/i18n';
import { categories, categoryTitle, categoryUrl, categoryProducts } from '../lib/catalog';
import type { Route } from '../lib/types';
interface Props {
  route: Route;
}
const { route } = Astro.props;
const { lang } = route,
  t = messages(lang);
const canonical = new URL(route.canonicalPath || route.path, Astro.site).href;
const preview = import.meta.env.SITE_NOINDEX === 'true';
const noindex = preview || route.noindex;
const topCategories = categories.filter((c) => !c.parentId && categoryProducts(c, lang).length > 0).slice(0, 8);
const translations = route.alternates || [{ lang, path: route.path }];
const homeFallback = (l: 'ru' | 'en' | 'ka') =>
  translations.find((a) => a.lang === l)?.path || basePath(l);
const languageLinks = (['ru', 'en', 'ka'] as const).map((language) => ({
  href: homeFallback(language),
  lang: language,
  label: language === 'ka' ? 'ქარ' : language.toUpperCase(),
}));
const phones = [
  { city: t.batumi, number: '+995571100515', display: '+995 571 10 05 15' },
  { city: t.tbilisi, number: '+995579404041', display: '+995 579 40 40 41' },
];
const menuPages = [
  { href: infoPath(lang, 'about'), label: t.about },
  { href: localePath(lang, 'catalog'), label: t.catalog, catalog: true },
  { href: infoPath(lang, 'delivery'), label: t.delivery },
  { href: infoPath(lang, 'contact'), label: t.contact },
];
const organization = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: 'SIMAL',
  url: 'https://simal.ge/',
  telephone: phones.map(({ number }) => number),
  email: 'info@simal.ge',
  logo: 'https://simal.ge/images/brand-logo.png',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2ed" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{route.title}</title>
    <meta name="description" content={route.description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />
    {!noindex &&
      translations
        .map((a) => (
          <link rel="alternate" hreflang={a.lang} href={new URL(a.path, Astro.site).href} />
        ))}
    {!noindex && translations.some((a) => a.lang === 'ru') && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(translations.find((a) => a.lang === 'ru')!.path, Astro.site).href}
      />
    )}
    <meta property="og:type" content={route.kind === 'product' ? 'product' : 'website'} />
    <meta property="og:title" content={route.title} />
    <meta property="og:description" content={route.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SIMAL" />
    <meta
      property="og:image"
      content={
        new URL(route.product?.images[0]?.src || '/images/hero/hero-1280.jpg', Astro.site).href
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization).replace(/</g, '\\u003c')}
    />
    <slot name="head" />
  </head>
  <body data-lang={lang}>
    <a class="skip-link" href="#main">
      {lang === 'ru' ? 'К содержанию' : lang === 'ka' ? 'შინაარსზე გადასვლა' : 'Skip to content'}
    </a>
    <div class="topbar">
      <div class="container topbar__inner">
        <span>SIMAL · {t.headerTagline}</span>
        <div class="topbar__phones">
          {phones.map(({ city, number, display }) => <a href={`tel:${number}`}>{display} ({city})</a>)}
        </div>
        <nav class="language-switch" aria-label="Language">
          {languageLinks.map((link) => (
            <a href={link.href} lang={link.lang} aria-current={link.lang === lang ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
    <div class="mobile-header">
      <div class="container mobile-topbar">
        <a class="mobile-brand" href={basePath(lang)}>
          <img src="/images/brand-logo.png" alt="" width="922" height="503" />
          <span><strong>SIMAL</strong><small>{t.headerTagline}</small></span>
        </a>
        <nav class="language-switch" aria-label="Language">
          {languageLinks.map((link) => (
            <a href={link.href} lang={link.lang} aria-current={link.lang === lang ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
        <HeaderActions lang={lang} compact />
        <button type="button" class="icon-button mobile-menu-button" aria-label={t.menu}
          aria-controls="mobile-navigation" aria-expanded="false" data-menu-toggle>
          <Icon name="menu" />
        </button>
      </div>
      <nav id="mobile-navigation" class="mobile-navigation" hidden aria-label={t.menu}>
        <div class="container mobile-navigation__inner">
          <div class="language-switch mobile-navigation__languages" aria-label="Language">
            {languageLinks.map((link) => (
              <a href={link.href} lang={link.lang} aria-current={link.lang === lang ? 'page' : undefined}>
                {link.label}
              </a>
            ))}
          </div>
          <div class="mobile-navigation__links">
            {menuPages.map(({ href, label, catalog }) => catalog ? (
              <details class="mobile-navigation__catalog">
                <summary>{label}</summary>
                <div>
                  <a href={href} aria-current={route.path === href ? 'page' : undefined}>{t.allCatalog}</a>
                  {topCategories.map((c) => (
                    <a href={categoryUrl(c, lang)} aria-current={route.category?.id === c.id ? 'page' : undefined}>
                      {categoryTitle(c, lang)}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a href={href} aria-current={route.path === href ? 'page' : undefined}>{label}</a>
            ))}
          </div>
          <div class="mobile-navigation__actions">
            <div class="mobile-contact-links">
              <a class="icon-button" href="tel:+995571100515" aria-label={t.callUs}><Icon name="phone" /></a>
              <a class="icon-button" href="https://t.me/+995571100515" aria-label="Telegram"><Icon name="telegram" /></a>
              <a class="icon-button" href="https://wa.me/995571100515" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
            </div>
            <button class="button button--dark" type="button" aria-haspopup="dialog"
              aria-controls="mobile-enquiry" data-enquiry-open>{t.enquiry}</button>
          </div>
        </div>
      </nav>
    </div>
    <header class="site-header">
      <div class="container header-main" data-header-main>
        <a class="brand" href={basePath(lang)} aria-label="SIMAL"><img class="brand-logo" src="/images/brand-logo.png" alt="SIMAL" width="922" height="503" fetchpriority="high" /></a>
        <form class="header-search" action={localePath(lang, 'search')} role="search">
          <label class="sr-only" for="header-query">
            {t.search}
          </label>
          <input
            id="header-query"
            name="q"
            type="search"
            placeholder={t.searchPlaceholder}
            autocomplete="off"
          />
          <button class="icon-button" aria-label={t.search}>
            <Icon name="search" size={21} />
          </button>
        </form>
        <HeaderActions lang={lang} />
      </div>
      <nav class="category-nav" aria-label={t.menu}>
        <div class="container">
          <a class="category-nav__brand" href={basePath(lang)} aria-label="SIMAL">
            <img src="/images/brand-logo.png" alt="" width="922" height="503" />
          </a>
          <div class="category-nav__links category-nav__pages">
            {menuPages.map(({ href, label }) => (
              <a href={href} aria-current={route.path === href ? 'page' : undefined}>{label}</a>
            ))}
          </div>
          <HeaderActions lang={lang} compact />
        </div>
      </nav>
    </header>
    <nav class="category-nav__sections" aria-label={t.catalog}>
      <div class="container category-nav__links">
        {topCategories.map((c) => (
          <a href={categoryUrl(c, lang)} aria-current={route.category?.id === c.id ? 'page' : undefined}>
            {categoryTitle(c, lang)}
          </a>
        ))}
      </div>
    </nav>
    <div id="header-call-options" class="call-options call-options--header" popover>
      {phones.map(({ city, number, display }) => <a href={`tel:${number}`}><strong>{city}</strong><span>{display}</span></a>)}
    </div>
    <div class="mobile-actions">
      <div class="container mobile-actions__inner">
        <button type="button" class="button" aria-haspopup="dialog"
          aria-controls="mobile-enquiry" data-enquiry-open>{t.leaveEnquiry}</button>
        <button type="button" class="button button--outline" popovertarget="mobile-call-options">
          <Icon name="phone" size={18} />
          {t.callUs}
        </button>
        <div id="mobile-call-options" class="call-options call-options--bottom" popover>
          {phones.map(({ city, number, display }) => <a href={`tel:${number}`}><strong>{city}</strong><span>{display}</span></a>)}
        </div>
      </div>
    </div>
    <dialog id="mobile-enquiry" class="enquiry-dialog" aria-labelledby="mobile-enquiry-title">
      <div class="enquiry-dialog__heading">
        <h2 id="mobile-enquiry-title">{t.enquiry}</h2>
        <button type="button" class="icon-button" aria-label={t.close} data-enquiry-close>
          <Icon name="close" />
        </button>
      </div>
      <form data-enquiry-form>
        <fieldset class="quote-fields">
          <label class="field"><span>{t.name}</span>
            <input name="customerName" autocomplete="name" required minlength="2" maxlength="100" autofocus />
          </label>
          <label class="field"><span>{t.enquiryPhone}</span>
            <input name="contact" type="tel" autocomplete="tel" required maxlength="120" />
          </label>
          <label class="field"><span>{t.enquiryDetails}</span>
            <textarea name="comment" required minlength="2" maxlength="1500" rows="3"></textarea>
          </label>
          <div hidden><input name="website" tabindex="-1" autocomplete="off" /></div>
          <button class="button button--dark" type="submit">{t.submit}</button>
        </fieldset>
        <p class="form-policy">{t.consent} <a href={infoPath(lang, 'privacy')}>{t.consentLink}</a>.</p>
        <p class="form-message" role="status" data-enquiry-status></p>
      </form>
    </dialog>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href={basePath(lang)}>
            SIMAL<span class="brand-dot">.</span>
          </a>
          <p class="footer-tagline">{t.footerText}</p>
          <a class="footer-email" href="mailto:info@simal.ge">
            info@simal.ge
            <Icon name="arrow" size={18} />
          </a>
        </div>
        <div>
          <h2>{t.catalog}</h2>
          {topCategories.slice(0, 5).map((c) => (
            <a href={categoryUrl(c, lang)}>{categoryTitle(c, lang)}</a>
          ))}
        </div>
        <div>
          <h2>SIMAL</h2>
          <a href={infoPath(lang, 'about')}>{t.about}</a>
          <a href={infoPath(lang, 'delivery')}>{t.delivery}</a>
          <a href={infoPath(lang, 'contact')}>{t.contact}</a>
          <a href={infoPath(lang, 'cooperation')}>{t.cooperation}</a>
        </div>
        <div>
          <h2>{t.contactUs}</h2>
          <span>{t.batumi}</span>
          <a href="tel:+995571100515">+995 571 10 05 15</a>
          <span>{t.tbilisi}</span>
          <a href="tel:+995579404041">+995 579 40 40 41</a>
          <a href="https://wa.me/995571100515" target="_blank" rel="noopener noreferrer">
            WhatsApp ↗
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getUTCFullYear()} {t.rights}
        </span>
        <a href={infoPath(lang, 'privacy')}>{t.privacy}</a>
        <span>GEORGIA</span>
      </div>
    </footer>
    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
    <script>
      import '../scripts/storefront';
    </script>
  </body>
</html>
