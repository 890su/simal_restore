# Build-time optional source. Leave blank to normalize the local recovered data.
# Only publishable product data belongs in the CSV; never customer contacts.
CATALOG_CSV_URL=

# Server runtime only. Copy these names into Cloudflare Pages secrets/settings.
# For local Pages Functions use .dev.vars (see .dev.vars.example).
# QUOTES_DB is a D1 binding in wrangler.toml / Cloudflare, not a string variable.
QUOTE_IP_HASH_SECRET=
QUOTE_ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
QUOTE_ALLOWED_ORIGINS=

# Optional. Do not set until a Turnstile widget/sitekey is integrated into the UI.
TURNSTILE_SECRET_KEY=

# GitHub Actions scheduler has separate repository secrets QUOTE_RETRY_URL and
# QUOTE_RETRY_TOKEN, plus opt-in Actions variable QUOTE_RETRY_ENABLED=true.
# Do not put these into browser-visible PUBLIC_* variables.
