{
  "name": "simal-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev --host 127.0.0.1",
    "catalog": "node scripts/import-catalog.mjs && node scripts/apply-translation-reviews.mjs",
    "catalog:archive": "node scripts/import-catalog.mjs --archive && node scripts/apply-translation-reviews.mjs",
    "translations": "node scripts/apply-translation-reviews.mjs",
    "content": "node scripts/extract-content.mjs",
    "prebuild": "npm run catalog && npm run content",
    "build": "npm run build:verified",
    "build:verified": "node scripts/prepare-public.mjs && node scripts/run-astro.mjs build && node scripts/verify-build.mjs",
    "check": "node scripts/run-astro.mjs check",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/run-astro.mjs preview --host 127.0.0.1",
    "format": "prettier --write src scripts tests functions"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "astro": "^7.4.7",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "wrangler": "^4.158.0"
  }
}
